{
  "name": "shop-accounts",
  "version": "1.7.0",
  "description": "نظام حسابات الفروع",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.shop.accounts",
    "productName": "ShopAccounts",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "fonts/**",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ShopAccounts",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sa222ab86-code",
        "repo": "shop-accounts"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "sa222ab86-code <sa222ab86-code@users.noreply.github.com>"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "repository": "github:sa222ab86-code/shop-accounts",
  "author": "sa222ab86-code"
}